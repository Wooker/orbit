/* Taken from */
/* https://github.com/ch32-rs/ch32-metapac/blob/main/src/chips/ch32x035c8t6/memory_x/memory.x */

MEMORY
{
    FLASH : ORIGIN = 0x00000000, LENGTH = 62K /* BANK_1 */
    RAM   : ORIGIN = 0x20000000, LENGTH = 20K
}
REGION_ALIAS("REGION_TEXT", FLASH);
REGION_ALIAS("REGION_RODATA", FLASH);
REGION_ALIAS("REGION_DATA", RAM);
REGION_ALIAS("REGION_BSS", RAM);
REGION_ALIAS("REGION_HEAP", RAM);
REGION_ALIAS("REGION_STACK", RAM);

PROVIDE(_port_int = 32 + 0x80000000);

PROVIDE(_SPI1_int = 33 + 0x80000000);
PROVIDE(_TIM1_BRK_int = 34 + 0x80000000);
PROVIDE(_TIM1_UP_int = 35 + 0x80000000);
PROVIDE(_TIM1_TRG_COM_int = 36 + 0x80000000);
PROVIDE(_TIM1_CC_int = 37 + 0x80000000);
PROVIDE(_TIM2_UP_int = 38 + 0x80000000);
PROVIDE(_USART2_int = 39 + 0x80000000);
PROVIDE(_EXTI15_8_int = 40 + 0x80000000);
PROVIDE(_EXTI25_16_int = 41 + 0x80000000);
PROVIDE(_USART3_int = 42 + 0x80000000);
PROVIDE(_USART4_int = 43 + 0x80000000);
    
